// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in.
//
// GOOGLE_PLACES_API_KEY: Google Cloud Console → enable "Places API (New)" →
// create an API key → restrict it to iOS apps with bundle id
// ai.florafauna.gimme AND restrict it to the Places API (New).
GOOGLE_PLACES_API_KEY = AIzaYourKeyHere

// Optional: Claude-powered query interpretation via the Supabase Edge Function
// in supabase/ (see supabase/README.md for deploy steps).
// GIMME_PROXY_URL is the function URL; GIMME_PROXY_AUTH_TOKEN is your Supabase
// project's anon key (Project Settings → API) — safe to ship in the app.
// NOTE: xcconfig treats // as a comment START, even inside values.
// Write URLs with the $() escape, like this:
// GIMME_PROXY_URL = https:/$()/your-project-ref.supabase.co/functions/v1/interpret
// GIMME_PROXY_AUTH_TOKEN = eyJ...your-anon-key...
